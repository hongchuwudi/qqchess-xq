{
  "name": "qqchess-proxy",
  "version": "1.0.0",
  "description": "QQ Chess H5 client wrapped in Electron with automatic mitmproxy capture",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^39.2.3"
  },
  "build": {
    "appId": "com.qqchess.proxy",
    "productName": "QQ象棋协议分析器",
    "extraResources": [
      { "from": "python", "to": "python" },
      { "from": "../engines", "to": "engines" },
      { "from": "../xq_ws_proxy.py", "to": "xq_ws_proxy.py" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "pikafish-bridge.js",
      "renderer.js",
      "index.html",
      "style.css"
    ]
  }
}
